# 민감 파일 (서버에서 직접 생성)
.env
openclaw/.env

# 테스트가 매 실행 만드는 렌더 캡처(레포 오염 금지, 2026-09-21 코드리뷰 MINOR).
# 육안 확인이 필요하면 TEST_CAPTURE_DIR 로 다른 경로를 지정한다.
docs/design/captures/quality-s1-pr1/

# 테넌트별 시크릿/런타임 (로컬 관리 — .env.{slug} 토큰·API키, config-{slug}/ 게이트웨이 토큰, data-{slug}/ 런타임 복사본)
.env.*
!.env.example
config-*/
data-*/

# 실제 설정 파일 (토큰 포함, 서버에서 example에서 복사)
config/openclaw.json
config/cron/jobs.json

# OpenClaw Gateway 런타임 (민감: 인증 토큰, 디바이스 키)
config/agents/
config/devices/
config/identity/

# OpenClaw Gateway 런타임 (비민감: 상태/로그)
config/memory/
config/workspace/
config/canvas/
config/logs/
config/cron/runs/
config/update-check.json
config/exec-approvals.json
config/media/
config/tasks/

# 데이터 (런타임) — .example만 추적, 실제 파일은 서비스별 로컬 관리
data/*
!data/*.example

# 로그
*.log

# 빌드 산출물 / 의존성 (최상위 — 추적 안 함)
node_modules/
dist-runtime/

# 민감어 denylist (fork-local — 목록 자체가 민감, 공개 안 함)
**/sensitive-denylist.local.json

# Python
__pycache__/
*.pyc

# Backup files
*.bak
*.bak.*

# OS
.DS_Store

# Docker Compose (서비스별 포트/이미지 설정, .example에서 복사)
docker-compose.yml
config/credentials/
config/subagents/
config/telegram/
tenants/
!data/templates/
!data/templates/**
# 브랜드 전용 prompt-guide/keywords 는 fork-local (업종 일반 템플릿만 추적)
data/templates/tenant1.*
data/templates/tenant5.*
data/templates/tenant3.*
data/templates/tenant4.*
data/templates/tenant2.*
.gstack/

# OSMU Studio 에셋 (대용량 미디어, git 미추적)
studio-assets/
.obsidian/
