{
  "name": "dashboard",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "OSMU_BUILD_COMMIT=$(git rev-parse HEAD) next dev --webpack",
    "build": "next build",
    "typecheck:ci": "tsc --noEmit -p tsconfig.ci.json",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:publish": "vitest run tests/publish",
    "audit:ui-tokens": "node scripts/ui-token-audit.mjs src --check",
    "e2e": "bash scripts/verify-e2e.sh",
    "e2e:local": "bash -c 'bash scripts/verify-e2e.sh \"${1:-http://localhost:3456}\"' _",
    "e2e:publish": "bash scripts/verify-publish-e2e.sh",
    "e2e:operator": "bash scripts/verify-operator-form-e2e.sh",
    "e2e:r02": "node scripts/verify-r02-e2e.mjs",
    "e2e:four-room": "node scripts/verify-four-room-ui-e2e.mjs",
    "ops:recover-operator-token": "bash scripts/recover-operator-token.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "proper-lockfile": "^4.1.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swr": "^2.4.1",
    "twitter-text": "3.1.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1056.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/twitter-text": "3.1.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typebox": "^1.1.39",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
